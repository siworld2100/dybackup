# Copy this file to secret.env and fill in real values.
# secret.env is gitignored; this example file is committed.
#
# Both keys are injected at build time by build_apk.bat as --dart-define.
# make_manifest.py reads MANIFEST_KEY as well, so the two sides always agree.
#
# You can also build without secret.env - the App then simply disables
# online update. Parsing and downloading keep working.
#
# Keep this file ASCII-only (see the note in secret.env).

MANIFEST_KEY=replace-with-your-own-random-string
MANIFEST_URL=http://your-host:8080/latest.json
